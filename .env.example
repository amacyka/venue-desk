# Токен приложения @CryptoBot → Crypto Pay → Create App.
# Нужен только для карточки Крипто Бота. Торговлю и переводы включать не нужно.
CRYPTOBOT_API_TOKEN=

# Токен бота пульта. @BotFather → /newbot → скопировать токен.
TELEGRAM_BOT_TOKEN=

# Публичный https терминала. Без него кнопка Mini App в боте не появляется.
# Локальный http://127.0.0.1 с телефона не открывается.
WEBAPP_URL=
